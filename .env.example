# Skylight Calendar MCP Server Configuration
# Copy this file to .env and fill in your values

# Your Skylight auth token (captured via Proxyman)
# Include the full header value, e.g., "Bearer abc123" or "Basic xyz789"
SKYLIGHT_AUTH_TOKEN=Bearer YOUR_TOKEN_HERE

# Your Skylight frame ID (your household identifier)
# Found in API URLs like /api/frames/{frameId}/chores
SKYLIGHT_FRAME_ID=YOUR_FRAME_ID_HERE
