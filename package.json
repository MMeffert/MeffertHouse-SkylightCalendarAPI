{
  "name": "skylight-mcp",
  "version": "1.0.0",
  "description": "MCP server for Skylight Calendar chore management",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "cdk:synth": "cdk synth",
    "cdk:diff": "cdk diff",
    "cdk:deploy": "cdk deploy --require-approval never",
    "cdk:destroy": "cdk destroy"
  },
  "keywords": [
    "mcp",
    "skylight",
    "calendar",
    "chores"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.980.0",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "aws-cdk-lib": "^2.236.0",
    "constructs": "^10.4.5",
    "esbuild": "^0.27.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "aws-cdk": "^2.1104.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
