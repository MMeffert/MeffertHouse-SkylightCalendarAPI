{
  "name": "skylight-mcp",
  "version": "1.0.0",
  "description": "MCP server for Skylight Calendar chore management",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "cdk:synth": "cdk synth",
    "cdk:diff": "cdk diff",
    "cdk:deploy": "cdk deploy --require-approval never",
    "cdk:destroy": "cdk destroy"
  },
  "keywords": [
    "mcp",
    "skylight",
    "calendar",
    "chores"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1029.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "aws-cdk-lib": "^2.248.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.28.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "aws-cdk": "^2.1118.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
